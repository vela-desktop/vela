#!/bin/sh
# SPDX-FileCopyrightText: 2026 Brando Giuffrida
# SPDX-License-Identifier: GPL-3.0-or-later

# The Vela session, started by SDDM (vela.desktop) or from a console. Each
# session's log stays in ~/.local/state/vela/ (the last and the previous one),
# to understand what happened if something goes wrong.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vela"
mkdir -p "$STATE_DIR"
[ -f "$STATE_DIR/vela.log" ] && mv -f "$STATE_DIR/vela.log" "$STATE_DIR/vela.log.old"

# --supervise: if the compositor crashes it's restarted, and Qt and KDE apps
# reconnect (see compositor/src/supervisor.c).
exec 2> "$STATE_DIR/vela.log"
printf 'vela-session: started_at=%s boot_id=%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$(cat /proc/sys/kernel/random/boot_id)" >&2
# Must run before loading any Vela binary compiled for the x86-64-v3 baseline.
# The helper is POSIX shell and runs on machines that cannot execute those binaries.
if ! "@CMAKE_INSTALL_FULL_LIBEXECDIR@/vela-cpu-check"; then
    echo "vela-session: CPU compatibility preflight failed; compositor not started" >&2
    exit 1
fi
# TEMPORARY until Vela Secrets: fix the credential backend for the entire
# session before the compositor (or any graphical autostart) is launched.
. "@CMAKE_INSTALL_FULL_LIBEXECDIR@/credential-compat/select-backend"
exec "@CMAKE_INSTALL_FULL_BINDIR@/vela-compositor" --supervise -s "@CMAKE_INSTALL_FULL_BINDIR@/vela-shell" "$@"
