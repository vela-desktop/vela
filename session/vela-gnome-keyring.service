[Unit]
Description=Vela GNOME keyring
Documentation=https://github.com/vela-desktop/vela
PartOf=vela-session.target
ConditionFileIsExecutable=/usr/bin/gnome-keyring-daemon

[Service]
Type=simple
ExecStart=/usr/bin/gnome-keyring-daemon --foreground --components=pkcs11,secrets,ssh
Restart=on-failure
Slice=session.slice
