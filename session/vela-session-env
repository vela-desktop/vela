# Ties Vela to the user's session (systemd --user and D-Bus), so the apps they
# start (portals, autostart apps) find this display. The compositor calls it:
# "start" as soon as the display is ready, "stop" on exit.
#
# The user's systemd manager is one for all their sessions: if another
# graphical session is already active (Plasma on another console, while trying
# Vela from a VT), nothing is touched, so as not to break it.

VARS="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP KDE_SESSION_VERSION QT_WAYLAND_RECONNECT XDG_SESSION_TYPE XDG_SESSION_DESKTOP QT_QPA_PLATFORMTHEME XDG_MENU_PREFIX"
STATE="${XDG_RUNTIME_DIR:-/tmp}/vela-session-${WAYLAND_DISPLAY:-none}"
# The compositor chooses GNOME or KDE for the keyring before this runs.
# Restoring the apps of
# the last Plasma session is ksmserver's job, which isn't here: its autostart
# entry is turned off for the duration of the session.
RESTORE='app-org.kde.plasma\x2dfallback\x2dsession\x2drestore@autostart.service'

command -v systemctl > /dev/null || exit 0

case "$1" in
start)
    # The active session may be ours, if the compositor was restarted after a
    # crash (same display): then only the variables are updated (DISPLAY can
    # change).
    if [ ! -e "$STATE" ] && systemctl --user -q is-active graphical-session.target; then
        echo "vela-session-env: another graphical session is already running, leaving it alone" >&2
        exit 0
    fi
    # Only the variables that have a value.
    SET=""
    for var in $VARS; do
        eval "value=\${$var-}"
        [ -n "$value" ] && SET="$SET $var"
    done
    # shellcheck disable=SC2086
    systemctl --user import-environment $SET
    if command -v dbus-update-activation-environment > /dev/null; then
        # shellcheck disable=SC2086
        dbus-update-activation-environment $SET
    fi
    : > "$STATE"
    systemctl --user -q mask --runtime "$RESTORE" 2> /dev/null
    if systemctl --user cat vela-session.target > /dev/null 2>&1; then
        systemctl --user --no-block start vela-session.target
    fi
    # The wallet is part of this session. PartOf=vela-session.target stops it
    # on logout, so it does not keep org.freedesktop.secrets afterwards.
    # systemd starts the process with a clear signal mask.
    case ":${XDG_CURRENT_DESKTOP:-}:" in
    *:GNOME:*) systemctl --user start vela-gnome-keyring.service ;;
    *:KDE:*) systemctl --user start vela-kwallet.service ;;
    esac
    ;;
stop)
    [ -e "$STATE" ] || exit 0
    rm -f "$STATE"
    systemctl --user stop vela-gnome-keyring.service vela-kwallet.service 2> /dev/null
    if systemctl --user cat vela-session.target > /dev/null 2>&1; then
        systemctl --user --no-block stop vela-session.target
    fi
    systemctl --user -q unmask --runtime "$RESTORE" 2> /dev/null
    # shellcheck disable=SC2086
    systemctl --user unset-environment $VARS
    ;;
*)
    echo "Usage: vela-session-env start|stop" >&2
    exit 1
    ;;
esac
