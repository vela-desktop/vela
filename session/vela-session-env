# Ties Vela to the user's session (systemd --user and D-Bus), so the apps they
# start (portals, autostart apps) find this display. The compositor calls it:
# "start" as soon as the display is ready, "stop" on exit.
#
# The user's systemd manager is one for all their sessions: if another
# graphical session is already active (Plasma on another console, while trying
# Vela from a VT), nothing is touched, so as not to break it.

VARS="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP KDE_SESSION_VERSION VELA_SECRET_BACKEND QT_WAYLAND_RECONNECT XDG_SESSION_TYPE XDG_SESSION_DESKTOP QT_QPA_PLATFORMTHEME XDG_MENU_PREFIX"
STATE="${XDG_RUNTIME_DIR:-/tmp}/vela-session-${WAYLAND_DISPLAY:-none}"
# TEMPORARY: vela-session has chosen GNOME or KWallet before this hook.
# Restoring the apps of the last Plasma session is ksmserver's job, not ours; its autostart
# entry is turned off for the duration of the session.
RESTORE='app-org.kde.plasma\x2dfallback\x2dsession\x2drestore@autostart.service'

command -v systemctl > /dev/null || exit 0

case "$1" in
start)
    # The active session may be ours, if the compositor was restarted after a
    # crash (same display): then only the variables are updated (DISPLAY can
    # change).
    if [ ! -e "$STATE" ] && systemctl --user -q is-active graphical-session.target; then
        echo "vela-session-env: another graphical session is already running, leaving it alone" >&2
        exit 0
    fi
    # A restarted compositor reimports environment but must not restart a
    # credential provider (and certainly not switch it while apps are running).
    FIRST_START=0
    [ ! -e "$STATE" ] && FIRST_START=1
    # Only the variables that have a value.
    SET=""
    for var in $VARS; do
        eval "value=\${$var-}"
        [ -n "$value" ] && SET="$SET $var"
    done
    # shellcheck disable=SC2086
    systemctl --user import-environment $SET
    # Importing only nonempty variables would preserve a stale KDE marker
    # in the shared user manager when a GNOME backend is selected.
    if [ "${VELA_SECRET_BACKEND:-kwallet}" = gnome ]; then
        systemctl --user unset-environment KDE_SESSION_VERSION
    fi
    if command -v dbus-update-activation-environment > /dev/null; then
        # shellcheck disable=SC2086
        dbus-update-activation-environment $SET
        if [ "${VELA_SECRET_BACKEND:-kwallet}" = gnome ]; then
            # D-Bus activation environment cannot unset a value; clear it.
            KDE_SESSION_VERSION=
            export KDE_SESSION_VERSION
            dbus-update-activation-environment KDE_SESSION_VERSION
        fi
    fi
    : > "$STATE"
    systemctl --user -q mask --runtime "$RESTORE" 2> /dev/null
    if [ "$FIRST_START" -eq 1 ]; then
        # Owned by vela-session.target; do not touch the daemon PAM may own.
        # GNOME's --start initializes a pre-unlocked PAM daemon when present.
        case "${VELA_SECRET_BACKEND:-kwallet}" in
            gnome) systemctl --user start vela-gnome-keyring-compat.service ||
                echo "vela-session-env: unable to start GNOME keyring compatibility" >&2 ;;
            kwallet) systemctl --user start vela-kwallet-compat.service ||
                echo "vela-session-env: unable to start KWallet compatibility" >&2 ;;
        esac
    fi
    if systemctl --user cat vela-session.target > /dev/null 2>&1; then
        systemctl --user --no-block start vela-session.target
    fi
    ;;
stop)
    [ -e "$STATE" ] || exit 0
    rm -f "$STATE"
    # Only the services started by Vela. Other user/PAM-owned daemons remain.
    systemctl --user --no-block stop vela-gnome-keyring-compat.service vela-kwallet-compat.service 2> /dev/null
    if systemctl --user cat vela-session.target > /dev/null 2>&1; then
        systemctl --user --no-block stop vela-session.target
    fi
    systemctl --user -q unmask --runtime "$RESTORE" 2> /dev/null
    # shellcheck disable=SC2086
    systemctl --user unset-environment $VARS
    ;;
*)
    echo "Usage: vela-session-env start|stop" >&2
    exit 1
    ;;
esac
