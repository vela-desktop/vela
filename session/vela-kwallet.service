[Unit]
Description=Vela KWallet
Documentation=https://github.com/vela-desktop/vela
PartOf=vela-session.target
ConditionFileIsExecutable=/usr/bin/kwalletd6

[Service]
Type=simple
ExecStart=/usr/bin/kwalletd6
Restart=on-failure
Slice=session.slice
