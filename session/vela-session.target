[Unit]
Description=Sessione di Vela
Documentation=https://github.com/vela-desktop/vela
# It's the graphical session: portals and autostart apps (XDG autostart)
# start and stop with it. Not the polkit agent: the compositor starts it, so
# it is in the compositor's logind session (docs/polkit-agent.md §4.1).
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
Wants=xdg-desktop-autostart.target
