#version 450
layout(local_size_x = 64) in;
layout(push_constant) uniform Push { uint iterations; } push;
layout(std430, binding = 0) buffer Result { float value[]; } result;
void main()
{
    uint id=gl_GlobalInvocationID.x;
    float v=float(id)*0.01;
    for(uint i=0u;i<push.iterations;++i)v=fract(sin(v*1.618+0.5)*43758.5453);
    result.value[id]=v;
}
