# The container's command on Vast.ai: runs one job as the just-in-time runner
# that scripts/vast-runner.py registered, as the unprivileged user "runner".
# The workflow destroys the instance afterwards; the timeout is a backstop.
set -eu
: "${VELA_RUNNER_JITCONFIG:?}" "${VELA_RUNNER_VERSION:?}"

# Some hosts' NVIDIA drivers don't give Vulkan the dmabuf extensions Vela
# needs (compositor/src/render/vulkan.c). Exit without a runner, so that
# scripts/vast-runner.py destroys this instance and tries another offer.
for icd in /etc/vulkan/icd.d/nvidia_icd.json /usr/share/vulkan/icd.d/nvidia_icd.json; do
    [ -f "$icd" ] && break
done
extensions=$(VK_DRIVER_FILES=$icd vulkaninfo 2>/dev/null || true)
for ext in VK_EXT_image_drm_format_modifier VK_KHR_external_memory_fd VK_EXT_external_memory_dma_buf \
           VK_EXT_queue_family_foreign VK_KHR_external_semaphore_fd VK_EXT_physical_device_drm; do
    case $extensions in
        *"$ext"*) ;;
        *) echo "vela-ci-runner: NVIDIA's Vulkan here has no $ext" >&2; exit 1 ;;
    esac
done

dir=/home/runner/actions-runner
mkdir -p "$dir"
curl -fsSL "https://github.com/actions/runner/releases/download/v$VELA_RUNNER_VERSION/actions-runner-linux-x64-$VELA_RUNNER_VERSION.tar.gz" \
    | tar -xz -C "$dir"
chown -R runner:runner "$dir"

jit=$VELA_RUNNER_JITCONFIG
unset VELA_RUNNER_JITCONFIG
exec timeout 150m sudo -u runner -H sh -c 'cd "$1" && exec ./run.sh --jitconfig "$2"' sh "$dir" "$jit"
