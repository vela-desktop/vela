"""Source-tree CLI; read-only commands need no installation or elevated access."""

from pathlib import Path
import sys

if sys.version_info < (3, 11):
    sys.exit("vela-bench requires Python 3.11 or newer (standard library only)")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "benchmarks"))
from vela_bench.cli import main

sys.exit(main())
