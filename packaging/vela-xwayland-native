#!/bin/sh
# SPDX-FileCopyrightText: 2026 Brando Giuffrida
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Run one X11/Proton application through native-resolution Xwayland Satellite
# without changing Vela's Wayland display scale or its built-in Xwayland.
set -eu

if [ "$#" -eq 0 ]; then
    echo "usage: vela-xwayland-native COMMAND [ARG ...]" >&2
    exit 2
fi
if ! command -v xwayland-satellite >/dev/null 2>&1; then
    echo "vela-xwayland-native: install xwayland-satellite >= 0.6" >&2
    exit 127
fi
if ! command -v xrandr >/dev/null 2>&1; then
    echo "vela-xwayland-native: xrandr is required for readiness and primary-output selection" >&2
    exit 127
fi
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "vela-xwayland-native: start this from an active Wayland session" >&2
    exit 2
fi

# Reserve the chosen display among concurrent wrappers. Never touch another
# X server's socket or lock, and do not use the host's existing DISPLAY.
slot=
n=80
while [ "$n" -le 199 ]; do
    if [ ! -e "/tmp/.X$n-lock" ] && [ ! -e "/tmp/.X11-unix/X$n" ] \
        && mkdir "${XDG_RUNTIME_DIR}/vela-native-x11-$n.lock" 2>/dev/null; then
        slot=$n
        break
    fi
    n=$((n + 1))
done
if [ -z "$slot" ]; then
    echo "vela-xwayland-native: no unused X display from :80 to :199" >&2
    exit 1
fi

satellite_pid=
cleanup() {
    if [ -n "$satellite_pid" ]; then
        kill "$satellite_pid" 2>/dev/null || :
        wait "$satellite_pid" 2>/dev/null || :
    fi
    rmdir "${XDG_RUNTIME_DIR}/vela-native-x11-$slot.lock" 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

xwayland-satellite ":$slot" &
satellite_pid=$!
export DISPLAY=":$slot"
ready=
attempt=0
while [ "$attempt" -lt 150 ]; do
    if xrandr --query >/dev/null 2>&1; then
        ready=1
        break
    fi
    if ! kill -0 "$satellite_pid" 2>/dev/null; then break; fi
    sleep 0.1
    attempt=$((attempt + 1))
done
if [ -z "$ready" ]; then
    echo "vela-xwayland-native: satellite did not become ready" >&2
    exit 1
fi

# The selected Vela primary must also be RandR primary on the NEW X server.
# Preserve the value if Settings has already selected a main monitor.
primary="${VELA_X11_PRIMARY:-}"
if [ -z "$primary" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/Vela/vela-shell.conf" ]; then
    primary=$(awk '
        /^\[display\]$/ { section = 1; next }
        /^\[/ { section = 0 }
        section && /^primaryOutput=/ { sub(/^primaryOutput=/, ""); print; exit }
    ' "${XDG_CONFIG_HOME:-$HOME/.config}/Vela/vela-shell.conf")
fi
if [ -n "$primary" ]; then
    xrandr --output "$primary" --primary >/dev/null 2>&1 \
        || echo "vela-xwayland-native: XRandR output '$primary' unavailable" >&2
fi

"$@"
