# Vela as an Arch / CachyOS package, from the git repository.
#
#   cd packaging/arch && makepkg -si      installs
#   vela-update                           then updates (see vela-update --help)
#
# The public repository is fetched over HTTPS, without SSH keys. To build
# from a local copy, including changes not yet pushed but
# already committed:
#
#   VELA_GIT_URL=file:///path/to/vela makepkg -si
#
# The version comes from the project and the commits (0.1.0.r123.gabcdef0):
# every new commit is an update.

pkgname=vela-git
_name=vela
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="A modern, fluid and sharp desktop environment for Wayland"
arch=('x86_64')
url="https://github.com/vela-desktop/vela"
license=('GPL-3.0-or-later')
depends=(
    'wlroots0.20' 'wayland' 'libxkbcommon' 'pixman' 'libinput' 'libdrm' 'mesa' 'vulkan-icd-loader'
    'freetype2' 'harfbuzz' 'fontconfig' 'librsvg' 'cairo'
    'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'layer-shell-qt'
    'pam' 'polkit' 'hicolor-icon-theme' 'python' 'xorg-xwayland'
    'pipewire' 'wireplumber'
    'systemd-libs' # sd-bus: the laptop backlight through logind (docs/brightness.md §5.3)
)
makedepends=('git' 'cmake' 'shaderc' 'vulkan-headers' 'wayland-protocols>=1.37' 'qt6-tools' 'qt6-multimedia')
optdepends=(
    'cosign: verify downloaded prebuilt package attestations without gh'
    'xdg-desktop-portal-wlr: screen sharing'
    'xdg-desktop-portal-kde: file chooser and other portals for apps'
    'breeze-icons: Vela icons (breeze and breeze-dark)'
    'plasma-workspace: light or dark colors for KDE apps'
    'networkmanager: network and Wi-Fi (quick settings and Settings)'
    'bluez: Bluetooth'
    'pipewire-pulse: sound for apps that still use PulseAudio'
    'power-profiles-daemon: energy saver'
    'udisks2: unmounted drives in File Explorer'
    'kimageformats: AVIF, HEIF, JPEG XL and other pictures in File Explorer (thumbnails, quick preview)'
    'qt6-multimedia: videos and sounds in the File Explorer quick preview'
    'xdg-utils: share by email, default apps'
    'kdeconnect: share with your phone'
    'bluedevil: share via Bluetooth'
    'konsole: the terminal (Super+Enter)'
)
provides=('vela')
conflicts=('vela')
backup=('etc/pam.d/vela-lock' 'etc/xdg/xdg-desktop-portal-wlr/Vela')
source=("$_name::git+${VELA_GIT_URL:-https://github.com/vela-desktop/vela.git}")
sha256sums=('SKIP')

pkgver() {
    cd "$_name" || return 1
    local version count revision
    # Accept normal CMake whitespace and trailing comments; reject empty output.
    version=$(sed -nE 's/^[[:space:]]*VERSION[[:space:]]+([0-9]+(\.[0-9]+)+)([[:space:]]*(#.*|\))?)?$/\1/p' CMakeLists.txt | head -n 1)
    if [[ ! $version =~ ^[0-9]+(\.[0-9]+)+$ ]]; then
        printf 'vela-git: unable to parse project VERSION from CMakeLists.txt\n' >&2
        return 1
    fi
    count=$(git rev-list --count HEAD) || return 1
    revision=$(git rev-parse --short=7 HEAD) || return 1
    printf '%s.r%s.g%s' "$version" "$count" "$revision"
}

build() {
    # vela-shell uses Qt6::GuiPrivate; rebuild the package after Qt upgrades.
    # Do not pin qt6-base to an exact version on rolling Arch derivatives.

    # makepkg.conf gives the build options (CMAKE_BUILD_TYPE=None).
    cmake -B build -S "$_name" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib/vela \
        -DVELA_BUILD_TOOLS=OFF \
        -Wno-dev
    cmake --build build
}

check() {
    # Lightweight build/packaging checks; GPU-intensive tests remain in CI.
    test -x build/compositor/vela-compositor
    test -x build/shell/vela-shell
    bash -n "$_name/packaging/vela-update"
    PYTHONPYCACHEPREFIX="$srcdir/.vela-pycache" python -m py_compile "$_name/packaging/verify-attestation.py"
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm755 "$_name/packaging/vela-update" "$pkgdir/usr/bin/vela-update"
    install -Dm644 "$_name/packaging/verify-attestation.py" "$pkgdir/usr/lib/vela/verify-attestation.py"
}
