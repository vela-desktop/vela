# Updates Vela installed as a package (vela-git): fetches the new commits,
# shows what changes, builds the package with makepkg and installs it with
# pacman (asks for the password). The new version starts at the next session.
#
# If GitHub Actions has already built that commit's package (and gh is there,
# logged into the account), it asks whether to download it instead of building:
# no minutes of compiling, and no compiler crashes.
#
# The repository is kept in ~/.cache/vela-update, so each time only new commits
# are fetched; the last packages stay there too, to go back: sudo pacman -U
# ~/.cache/vela-update/packages/<file>.

set -eu

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vela/updates.conf"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/vela-update"
MIRROR="$CACHE/vela.git"
PACKAGES="$CACHE/packages"
DEFAULT_SOURCE="https://github.com/vela-desktop/vela.git"
KEEP=3 # old packages to keep

usage() {
    cat << EOF
Usage: vela-update [options]

Updates Vela to the repository's default branch and installs it.

  --branch NAME       install the latest commit of this branch, just this time
  --commit SHA        install this exact commit (full or abbreviated SHA),
                      just this time; cannot be combined with --branch
  --check             only tell whether there is an update and what changed
                      (exits with 0 if there is one, 1 if Vela is up to date)
  --force             rebuild and reinstall even if Vela is up to date
  --build             always build here, even if GitHub has the package
  --download          if GitHub has the package, download it without asking
  --jobs N            parallel compile jobs (otherwise those of
                      /etc/makepkg.conf); 1 is slow but safe
  --source URL|DIR    where to get Vela from: a git repository or a folder
                      (its commits, not uncommitted changes). Remembered
                      for next time. GitHub URLs always use HTTPS.
                      Default: $DEFAULT_SOURCE
EOF
}

check=0
force=0
prefer=""
jobs=""
source=""
branch=""
commit=""
while [ $# -gt 0 ]; do
    case "$1" in
    --check) check=1 ;;
    --force) force=1 ;;
    --build) prefer=build ;;
    --download) prefer=download ;;
    --branch | --commit)
        option="$1"
        if [ $# -lt 2 ] || [ -z "$2" ]; then
            echo "vela-update: $option needs a value" >&2; exit 2
        fi
        shift
        case "$option" in
        --branch) branch="$1" ;;
        --commit) commit="$1" ;;
        esac
        ;;
    --branch=*) branch="${1#*=}"; [ -n "$branch" ] || { echo "vela-update: --branch needs a value" >&2; exit 2; } ;;
    --commit=*) commit="${1#*=}"; [ -n "$commit" ] || { echo "vela-update: --commit needs a value" >&2; exit 2; } ;;
    --jobs)
        [ "$#" -ge 2 ] || { echo "vela-update: --jobs needs a value" >&2; exit 2; }
        shift
        jobs="$1"
        [ -n "$jobs" ] || { echo "vela-update: --jobs needs a value" >&2; exit 2; }
        ;;
    --jobs=*) jobs="${1#*=}"; [ -n "$jobs" ] || { echo "vela-update: --jobs needs a value" >&2; exit 2; } ;;
    --source)
        [ "$#" -ge 2 ] || { echo "vela-update: --source needs a value" >&2; exit 2; }
        shift
        source="$1"
        [ -n "$source" ] || { echo "vela-update: --source needs a value" >&2; exit 2; }
        ;;
    --source=*) source="${1#*=}"; [ -n "$source" ] || { echo "vela-update: --source needs a value" >&2; exit 2; } ;;
    -h | --help) usage; exit 0 ;;
    *) echo "vela-update: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done
if [ -n "$branch" ] && [ -n "$commit" ]; then
    echo "vela-update: use either --branch or --commit, not both" >&2; exit 2
fi
if [ -n "$branch" ] && ! git check-ref-format --branch "$branch" > /dev/null 2>&1; then
    echo "vela-update: invalid branch name: $branch" >&2; exit 2
fi
case "$commit" in
*[!0-9a-fA-F]*) echo "vela-update: --commit needs a full or abbreviated commit SHA" >&2; exit 2 ;;
esac
if [ -n "$jobs" ]; then
    case "$jobs" in
    *[!0-9]* | 0) echo "vela-update: --jobs needs a number" >&2; exit 2 ;;
    esac
fi

# Serialize every cache/config operation, including --check. Two updater
# processes must never delete each other's build directory or modify the
# same Git mirror while a build is reading it.
mkdir -p "$CACHE"
if ! command -v flock >/dev/null 2>&1; then
    echo "vela-update: flock (util-linux) is required" >&2
    exit 1
fi
exec 9>"$CACHE/update.lock"
if ! flock -n 9; then
    echo "vela-update: another update is already running (try again later)" >&2
    exit 1
fi

STAGED_MIRROR=""
BACKUP_MIRROR=""
DOWNLOAD=""
WORK=""
cleanup() {
    [ -z "$WORK" ] || rm -rf -- "$WORK"
    [ -z "$DOWNLOAD" ] || rm -rf -- "$DOWNLOAD"
    [ -z "$STAGED_MIRROR" ] || rm -rf -- "$STAGED_MIRROR"
    if [ -n "$BACKUP_MIRROR" ]; then
        if [ ! -d "$MIRROR" ]; then
            mv -- "$BACKUP_MIRROR" "$MIRROR" || true
        else
            rm -rf -- "$BACKUP_MIRROR"
        fi
    fi
}
trap 'status=$?; cleanup; exit "$status"' 0
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# From where: the one given now (and remembered), the remembered one, GitHub.
# The old file was called aggiornamenti.conf (key sorgente=).
githubHTTPS() {
    case "$1" in
    # Map existing installations to the organization, including stored SSH URLs.
    https://github.com/BrandoDev/vela|https://github.com/BrandoDev/vela.git|ssh://git@github.com/BrandoDev/vela|ssh://git@github.com/BrandoDev/vela.git|git@github.com:BrandoDev/vela|git@github.com:BrandoDev/vela.git)
        printf '%s\n' "$DEFAULT_SOURCE" ;;
    ssh://git@github.com/*) printf 'https://github.com/%s\n' "${1#ssh://git@github.com/}" ;;
    git@github.com:*) printf 'https://github.com/%s\n' "${1#git@github.com:}" ;;
    *) printf '%s\n' "$1" ;;
    esac
}
OLD_CONFIG="$(dirname "$CONFIG")/aggiornamenti.conf"
migrate_legacy=0
remember=0
if [ -n "$source" ]; then
    remember=1
    if [ -d "$source" ]; then
        source=$(cd "$source" && pwd)
    fi
elif [ -f "$CONFIG" ]; then
    source=$(sed -n 's/^source=//p' "$CONFIG" | head -n 1)
elif [ -f "$OLD_CONFIG" ]; then
    source=$(sed -n 's/^sorgente=//p' "$OLD_CONFIG" | head -n 1)
    migrate_legacy=1
    remember=1
fi
source="${source:-$DEFAULT_SOURCE}"
# Migrate saved or explicit old-repository URLs and GitHub SSH URLs
# to the canonical public HTTPS repository.
https_source=$(githubHTTPS "$source")
if [ "$https_source" != "$source" ]; then
    source="$https_source"
    remember=1
fi

# If launched from a fresh checkout of the official repository, seed the
# private mirror from its local Git objects. The mirror remains independent of
# the checkout, and tracks public HTTPS for later updates. This avoids fetching
# the same history twice during the first installation.
bootstrap=""
if [ "$source" = "$DEFAULT_SOURCE" ] && [ ! -d "$MIRROR" ]; then
    candidate=$(CDPATH= cd "$(dirname "$0")/../.." 2> /dev/null && pwd) || candidate=""
    if [ -n "$candidate" ] && [ -d "$candidate/.git" ] \
        && [ "$(git -C "$candidate" rev-parse --show-toplevel 2> /dev/null || true)" = "$candidate" ]; then
        origin=$(git -C "$candidate" remote get-url origin 2> /dev/null || true)
        case "$(githubHTTPS "$origin")" in
        "$DEFAULT_SOURCE"|https://github.com/vela-desktop/vela)
            bootstrap="$candidate" ;;
        esac
    fi
fi

# Fetch into a separate mirror when switching origins, so a failed source
# cannot destroy a known-good cache. The active mirror stays untouched until
# the new source and requested revision have both been verified.
active_mirror="$MIRROR"
new_mirror=0
previous_origin=""
if [ -d "$MIRROR" ]; then
    cached_source=$(git -C "$MIRROR" config remote.origin.url 2>/dev/null || true)
    if [ "$cached_source" != "$source" ]; then
        if [ "$(githubHTTPS "$cached_source")" = "$source" ]; then
            previous_origin="$cached_source"
            git -C "$MIRROR" remote set-url origin "$source"
        else
            new_mirror=1
        fi
    fi
else
    new_mirror=1
fi
echo ":: Checking for updates in $source"
if [ "$new_mirror" = 1 ]; then
    STAGED_MIRROR=$(mktemp -d "$CACHE/vela-mirror.XXXXXXXX")
    active_mirror="$STAGED_MIRROR"
    if [ -n "$bootstrap" ]; then
        echo ":: Reusing Git objects from the checkout (no second full download)"
        fetched=$(git clone --quiet --mirror --no-hardlinks "$bootstrap" "$STAGED_MIRROR" > /dev/null 2>&1 \
            && git -C "$STAGED_MIRROR" remote set-url origin "$source" \
            && git -C "$STAGED_MIRROR" remote update --prune > /dev/null 2>&1 && echo yes || echo no)
    else
        fetched=$(git clone --quiet --mirror "$source" "$STAGED_MIRROR" > /dev/null 2>&1 && echo yes || echo no)
    fi
else
    fetched=$(git -C "$MIRROR" remote update --prune > /dev/null 2>&1 && echo yes || echo no)
fi
if [ "$fetched" = no ]; then
    if [ -n "$previous_origin" ]; then
        git -C "$MIRROR" remote set-url origin "$previous_origin" || true
    fi
    echo "vela-update: can't download Vela from $source." >&2
    exit 1
fi

# Resolve once: the changelog, CI artifact and local build must all use the
# same commit. Selecting a test version never changes the mirror's HEAD.
target=HEAD
if [ -n "$branch" ]; then
    target="refs/heads/$branch"
elif [ -n "$commit" ]; then
    target="$commit"
fi
if ! latestFull=$(git -C "$active_mirror" rev-parse --verify "$target^{commit}" 2> /dev/null); then
    # A full SHA may still be fetchable after its branch has been deleted.
    if [ -z "$commit" ] || ! git -C "$active_mirror" fetch --quiet origin "$commit" 2> /dev/null \
        || ! latestFull=$(git -C "$active_mirror" rev-parse --verify "$target^{commit}" 2> /dev/null); then
        [ -z "$previous_origin" ] || git -C "$MIRROR" remote set-url origin "$previous_origin" || true
        echo "vela-update: can't find the requested revision: $target" >&2
        exit 1
    fi
fi
# A valid staged mirror may now replace the old one. Keep the old one in a
# backup until the replacement is in place, and restore it in the exit trap
# if the second rename fails.
if [ -n "$STAGED_MIRROR" ]; then
    if [ -d "$MIRROR" ]; then
        backup_slot=$(mktemp -d "$CACHE/vela-backup.XXXXXXXX")
        rmdir "$backup_slot"
        mv -- "$MIRROR" "$backup_slot"
        BACKUP_MIRROR="$backup_slot"
    fi
    mv -- "$STAGED_MIRROR" "$MIRROR"
    STAGED_MIRROR=""
    [ -z "$BACKUP_MIRROR" ] || rm -rf -- "$BACKUP_MIRROR"
    BACKUP_MIRROR=""
fi

# Save a new source only after its fetch and revision resolution succeeded.
# Write via rename so interrupted writes cannot truncate the old config.
if [ "$remember" = 1 ]; then
    mkdir -p "$(dirname "$CONFIG")"
    temp_config=$(mktemp "$(dirname "$CONFIG")/.updates.conf.XXXXXXXX")
    chmod 600 "$temp_config"
    printf 'source=%s\n' "$source" > "$temp_config"
    mv -f -- "$temp_config" "$CONFIG"
fi
if [ "$migrate_legacy" = 1 ]; then
    rm -f -- "$OLD_CONFIG"
fi

latest=$(git -C "$MIRROR" rev-parse --short=7 "$latestFull")
echo ":: Selected revision: ${branch:-${commit:-default branch}} ($latestFull)"
installed=$(pacman -Q vela-git 2> /dev/null | sed -n 's/.*\.g\([0-9a-f]*\)-[0-9]*$/\1/p')

if [ -n "$installed" ] && [ "${latestFull#"$installed"}" != "$latestFull" ] && [ "$force" = 0 ]; then
    echo ":: Vela is up to date ($(pacman -Q vela-git | cut -d' ' -f2))."
    [ "$check" = 1 ] && exit 1
    exit 0
fi

# What's new: the commits after the installed one (if it's among them).
if [ -n "$installed" ] && git -C "$MIRROR" cat-file -e "$installed^{commit}" 2> /dev/null \
    && git -C "$MIRROR" merge-base --is-ancestor "$installed" "$latestFull" 2> /dev/null; then
    count=$(git -C "$MIRROR" rev-list --count "$installed..$latestFull")
    if [ "$count" -gt 0 ]; then
        echo ":: What's new ($count):"
        git -C "$MIRROR" log --format='   %s' "$installed..$latestFull"
    fi
elif [ -n "$installed" ]; then
    echo ":: Installed version: $(pacman -Q vela-git | cut -d' ' -f2); new: $latest"
else
    echo ":: Vela isn't installed as a package: installing it ($latest)."
fi

# The repository on GitHub ("owner/name"): from the source, or from its origin
# if it's a directory. Empty if it isn't on GitHub.
githubRepo() {
    url="$source"
    if [ -d "$source" ]; then
        url=$(git -C "$source" remote get-url origin 2> /dev/null || true)
    fi
    url=$(githubHTTPS "$url")
    printf '%s\n' "$url" | sed -n -E 's#^(ssh://git@github\.com/|git@github\.com:|https://github\.com/)([^/]+/[^/]+)$#\2#p' | sed 's/\.git$//'
}

# Public alpha releases are immutable and named after the full source commit.
# Check the manifest before downloading: only a matching x86_64 package with
# a valid SHA-256 entry may be installed. No GitHub login is required.
repo=$(githubRepo)
release_package=""
release_url=""
release_digest=""
if [ "$prefer" != build ] && [ -n "$repo" ] && command -v curl > /dev/null 2>&1; then
    release_url="https://github.com/$repo/releases/download/alpha-$latestFull"
    manifest="$CACHE/public-release-SHA256SUMS"
    if curl -fsSL --connect-timeout 5 --max-time 20 -o "$manifest" "$release_url/SHA256SUMS" 2> /dev/null; then
        if [ "$(wc -l < "$manifest")" -eq 1 ]; then
            release_digest=$(awk 'NR == 1 {print $1}' "$manifest")
            release_package=$(awk 'NR == 1 {print $2}' "$manifest")
            if ! printf '%s\n' "$release_digest" | grep -Eq '^[0-9a-f]{64}$' \
                || ! printf '%s\n' "$release_package" \
                    | grep -Eq "^vela-git-[[:alnum:].+_-]+\.g${latest}-[[:digit:]]+-x86_64\.pkg\.tar\.zst$"; then
                release_package=""
            fi
        fi
    fi
    rm -f "$manifest"
fi

# Legacy 14-day workflow artifacts are an optional authenticated fallback,
# mainly useful for manually built test branches without a public release.
ciRun=""
if [ -z "$release_package" ] && [ "$prefer" != build ] && [ -n "$repo" ] \
    && command -v gh > /dev/null && gh auth status > /dev/null 2>&1; then
    run=$(gh run list -R "$repo" -w build.yml -c "$latestFull" -s success -L 1 \
        --json databaseId -q '.[0].databaseId' 2> /dev/null || true)
    if [ -n "$run" ] && [ -n "$(gh api "repos/$repo/actions/runs/$run/artifacts" \
        -q '.artifacts[] | select(.name == "vela-git" and .expired == false) | .id' 2> /dev/null || true)" ]; then
        ciRun="$run"
    fi
fi

if [ "$check" = 1 ]; then
    if [ -n "$release_package" ]; then
        echo ":: Public alpha package available (no GitHub login needed)."
    elif [ -n "$ciRun" ]; then
        echo ":: GitHub already has the package: vela-update downloads it instead of building."
    fi
    exit 0
fi

mkdir -p "$PACKAGES"
if [ -d "$CACHE/pacchetti" ]; then
    mv -f "$CACHE"/pacchetti/* "$PACKAGES"/ 2> /dev/null || true
    rm -rf "$CACHE/pacchetti" "$CACHE/scaricato" "$CACHE/costruzione" "$CACHE/sorgenti"
fi

# Only the last packages, to be able to go back.
prune() {
    ls -t "$PACKAGES"/vela-git-*.pkg.tar.* 2> /dev/null | tail -n +$((KEEP + 1)) | while read -r old; do
        rm -f "$old"
    done
}

# Prefer an immutable public release. Verify its checksum before passing the
# package to pacman; on missing/corrupt downloads use the existing fallbacks.
if [ -n "$release_package" ]; then
    DOWNLOAD=$(mktemp -d "$CACHE/download.XXXXXXXX")
    printf '%s  %s\n' "$release_digest" "$release_package" > "$DOWNLOAD/SHA256SUMS"
    echo ":: Downloading public alpha package for $latestFull"
    if curl -fsSL --retry 2 --connect-timeout 5 --max-time 180 \
        -o "$DOWNLOAD/$release_package" "$release_url/$release_package" \
        && (cd "$DOWNLOAD" && sha256sum --check --status SHA256SUMS); then
        mv -f "$DOWNLOAD/$release_package" "$PACKAGES/"
        rm -rf -- "$DOWNLOAD"
        DOWNLOAD=""
        package="$PACKAGES/$release_package"
        if ! sudo pacman -U "$package"; then
            echo "vela-update: the verified package was downloaded but not installed. To install it:" >&2
            echo "   sudo pacman -U $package" >&2
            exit 1
        fi
        prune
        echo ":: Vela is up to date ($(pacman -Q vela-git | cut -d' ' -f2)). The new version"
        echo "   starts with your next session: sign out and back in."
        exit 0
    fi
    echo ":: Public package unavailable or failed checksum verification; falling back." >&2
    rm -rf -- "$DOWNLOAD"
    DOWNLOAD=""
fi

# Package ready on GitHub Actions: download it or build? Without a terminal
# (or with --download) it's downloaded.
if [ -n "$ciRun" ]; then
    answer=d
    if [ "$prefer" != download ] && [ -t 0 ]; then
        printf ':: GitHub already has the package built for this version.\n'
        printf '   Download and install it [D], or build it here [b]? '
        read -r answer || answer=d
    fi
    case "$answer" in
    b | B | build) ciRun="" ;;
    esac
fi
if [ -n "$ciRun" ]; then
    DOWNLOAD=$(mktemp -d "$CACHE/download.XXXXXXXX")
    echo ":: Downloading the package from GitHub"
    if gh run download "$ciRun" -R "$repo" -n vela-git -D "$DOWNLOAD" \
        && package=$(ls "$DOWNLOAD"/vela-git-[0-9]*."g$latest"-*.pkg.tar.* 2> /dev/null | head -n 1) \
        && [ -n "$package" ]; then
        mv -f "$package" "$PACKAGES/"
        rm -rf -- "$DOWNLOAD"
        DOWNLOAD=""
        package="$PACKAGES/$(basename "$package")"
        if ! sudo pacman -U "$package"; then
            echo "vela-update: the package was downloaded but not installed. To install it:" >&2
            echo "   sudo pacman -U $package" >&2
            exit 1
        fi
        prune
        echo ":: Vela is up to date ($(pacman -Q vela-git | cut -d' ' -f2)). The new version"
        echo "   starts with your next session: sign out and back in."
        exit 0
    fi
    rm -rf -- "$DOWNLOAD"
    DOWNLOAD=""
    echo ":: The GitHub package can't be downloaded: building it here." >&2
fi

# The build, with the new version's PKGBUILD.
WORK=$(mktemp -d "$CACHE/build.XXXXXXXX")
git -C "$MIRROR" show "$latestFull:packaging/arch/PKGBUILD" > "$WORK/PKGBUILD"
# Advertise the selected commit to makepkg's mirror clone even when it was
# fetched by SHA and no branch points to it anymore.
git -C "$MIRROR" update-ref refs/vela-update/selected "$latestFull"
cd "$WORK"
export VELA_GIT_URL="file://$MIRROR#commit=$latestFull"
if [ -n "$jobs" ]; then
    export MAKEFLAGS="-j$jobs"
fi
echo ":: Building the package (a few minutes)"
if ! BUILDDIR="$WORK" PKGDEST="$PACKAGES" SRCDEST="$CACHE/sources" \
    makepkg --syncdeps --install --clean --force; then
    echo >&2
    # Built, but pacman didn't install it (cancelled, wrong password).
    built=$(ls -t "$PACKAGES"/vela-git-*."g$latest"-*.pkg.tar.* 2> /dev/null | head -n 1)
    if [ -n "$built" ]; then
        echo "vela-update: the package is ready but wasn't installed. To install it:" >&2
        echo "   sudo pacman -U $built" >&2
        exit 1
    fi
    echo "vela-update: the update failed (see the messages above)." >&2
    echo "If the compiler crashed (\"internal compiler error\"), try again" >&2
    echo "with fewer parallel jobs: vela-update --jobs 2" >&2
    exit 1
fi
cd "$CACHE"
rm -rf -- "$WORK"
WORK=""

prune

echo ":: Vela is up to date ($(pacman -Q vela-git | cut -d' ' -f2)). The new version"
echo "   starts with your next session: sign out and back in."
