# Updates Vela installed as a package (vela-git): fetches the new commits,
# shows what changes, builds the package with makepkg and installs it with
# pacman (asks for the password). The new version starts at the next session.
#
# If GitHub Actions has already built that commit's package (and gh is there,
# logged into the account), it asks whether to download it instead of building:
# no minutes of compiling, and no compiler crashes.
#
# The repository is kept in ~/.cache/vela-update, so each time only new commits
# are fetched; the last packages stay there too, to go back: sudo pacman -U
# ~/.cache/vela-update/packages/<file>.

set -eu

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vela/updates.conf"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/vela-update"
MIRROR="$CACHE/vela.git"
PACKAGES="$CACHE/packages"
DEFAULT_SOURCE="https://github.com/vela-desktop/vela.git"
KEEP=3 # old packages to keep

usage() {
    cat << EOF
Usage: vela-update [options]

Updates Vela to the repository's default branch and installs it.

  --branch NAME       install the latest commit of this branch, just this time
  --commit SHA        install this exact commit (full or abbreviated SHA),
                      just this time; cannot be combined with --branch
  --check             only tell whether there is an update and what changed
                      (exits with 0 if there is one, 1 if Vela is up to date)
  --force             rebuild and reinstall even if Vela is up to date
  --build             always build here, even if GitHub has the package
  --download          if GitHub has the package, download it without asking
  --jobs N            parallel compile jobs (otherwise those of
                      /etc/makepkg.conf); 1 is slow but safe
  --source URL|DIR    where to get Vela from: a git repository or a folder
                      (its commits, not uncommitted changes). Remembered
                      for next time. GitHub URLs always use HTTPS.
                      Default: $DEFAULT_SOURCE
EOF
}

check=0
force=0
prefer=""
jobs=""
source=""
branch=""
commit=""
while [ $# -gt 0 ]; do
    case "$1" in
    --check) check=1 ;;
    --force) force=1 ;;
    --build) prefer=build ;;
    --download) prefer=download ;;
    --branch | --commit)
        option="$1"
        if [ $# -lt 2 ] || [ -z "$2" ]; then
            echo "vela-update: $option needs a value" >&2; exit 2
        fi
        shift
        case "$option" in
        --branch) branch="$1" ;;
        --commit) commit="$1" ;;
        esac
        ;;
    --branch=*) branch="${1#*=}"; [ -n "$branch" ] || { echo "vela-update: --branch needs a value" >&2; exit 2; } ;;
    --commit=*) commit="${1#*=}"; [ -n "$commit" ] || { echo "vela-update: --commit needs a value" >&2; exit 2; } ;;
    --jobs) shift; jobs="${1:-}" ;;
    --jobs=*) jobs="${1#*=}" ;;
    --source) shift; source="${1:-}" ;;
    --source=*) source="${1#*=}" ;;
    -h | --help) usage; exit 0 ;;
    *) echo "vela-update: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done
if [ -n "$branch" ] && [ -n "$commit" ]; then
    echo "vela-update: use either --branch or --commit, not both" >&2; exit 2
fi
if [ -n "$branch" ] && ! git check-ref-format --branch "$branch" > /dev/null 2>&1; then
    echo "vela-update: invalid branch name: $branch" >&2; exit 2
fi
case "$commit" in
*[!0-9a-fA-F]*) echo "vela-update: --commit needs a full or abbreviated commit SHA" >&2; exit 2 ;;
esac
if [ -n "$jobs" ]; then
    case "$jobs" in
    *[!0-9]* | 0) echo "vela-update: --jobs needs a number" >&2; exit 2 ;;
    esac
fi

# From where: the one given now (and remembered), the remembered one, GitHub.
# The old file was called aggiornamenti.conf (key sorgente=).
githubHTTPS() {
    case "$1" in
    # Map existing installations to the organization, including stored SSH URLs.
    https://github.com/BrandoDev/vela|https://github.com/BrandoDev/vela.git|ssh://git@github.com/BrandoDev/vela|ssh://git@github.com/BrandoDev/vela.git|git@github.com:BrandoDev/vela|git@github.com:BrandoDev/vela.git)
        printf '%s\n' "$DEFAULT_SOURCE" ;;
    ssh://git@github.com/*) printf 'https://github.com/%s\n' "${1#ssh://git@github.com/}" ;;
    git@github.com:*) printf 'https://github.com/%s\n' "${1#git@github.com:}" ;;
    *) printf '%s\n' "$1" ;;
    esac
}
OLD_CONFIG="$(dirname "$CONFIG")/aggiornamenti.conf"
if [ ! -f "$CONFIG" ] && [ -f "$OLD_CONFIG" ]; then
    sed 's/^sorgente=/source=/' "$OLD_CONFIG" > "$CONFIG" && rm -f "$OLD_CONFIG"
fi
remember=0
if [ -n "$source" ]; then
    remember=1
    if [ -d "$source" ]; then
        source=$(cd "$source" && pwd)
    fi
elif [ -f "$CONFIG" ]; then
    source=$(sed -n 's/^source=//p' "$CONFIG" | head -n 1)
fi
source="${source:-$DEFAULT_SOURCE}"
# Migrate saved or explicit old-repository URLs and GitHub SSH URLs
# to the canonical public HTTPS repository.
https_source=$(githubHTTPS "$source")
if [ "$https_source" != "$source" ]; then
    source="$https_source"
    remember=1
fi
if [ "$remember" = 1 ]; then
    mkdir -p "$(dirname "$CONFIG")"
    printf 'source=%s\n' "$source" > "$CONFIG"
fi

# The repository: cloned the first time, then only new commits.
mkdir -p "$CACHE"
if [ -d "$MIRROR" ]; then
    cached_source=$(git -C "$MIRROR" config remote.origin.url)
    if [ "$cached_source" != "$source" ]; then
        if [ "$(githubHTTPS "$cached_source")" = "$source" ]; then
            git -C "$MIRROR" remote set-url origin "$source"
        else
            rm -rf "$MIRROR"
        fi
    fi
fi
echo ":: Checking for updates in $source"
if [ -d "$MIRROR" ]; then
    fetched=$(git -C "$MIRROR" remote update --prune > /dev/null 2>&1 && echo yes || echo no)
else
    fetched=$(git clone --quiet --mirror "$source" "$MIRROR" > /dev/null 2>&1 && echo yes || echo no)
fi
if [ "$fetched" = no ]; then
    [ -d "$MIRROR/refs" ] || rm -rf "$MIRROR"
    echo "vela-update: can't download Vela from $source." >&2
    exit 1
fi

# Resolve once: the changelog, CI artifact and local build must all use the
# same commit. Selecting a test version never changes the mirror's HEAD.
target=HEAD
if [ -n "$branch" ]; then
    target="refs/heads/$branch"
elif [ -n "$commit" ]; then
    target="$commit"
fi
if ! latestFull=$(git -C "$MIRROR" rev-parse --verify "$target^{commit}" 2> /dev/null); then
    # A full SHA may still be fetchable after its branch has been deleted.
    if [ -z "$commit" ] || ! git -C "$MIRROR" fetch --quiet origin "$commit" 2> /dev/null \
        || ! latestFull=$(git -C "$MIRROR" rev-parse --verify "$target^{commit}" 2> /dev/null); then
        echo "vela-update: can't find the requested revision: $target" >&2
        exit 1
    fi
fi
latest=$(git -C "$MIRROR" rev-parse --short=7 "$latestFull")
echo ":: Selected revision: ${branch:-${commit:-default branch}} ($latestFull)"
installed=$(pacman -Q vela-git 2> /dev/null | sed -n 's/.*\.g\([0-9a-f]*\)-[0-9]*$/\1/p')

if [ -n "$installed" ] && [ "${latestFull#"$installed"}" != "$latestFull" ] && [ "$force" = 0 ]; then
    echo ":: Vela is up to date ($(pacman -Q vela-git | cut -d' ' -f2))."
    [ "$check" = 1 ] && exit 1
    exit 0
fi

# What's new: the commits after the installed one (if it's among them).
if [ -n "$installed" ] && git -C "$MIRROR" cat-file -e "$installed^{commit}" 2> /dev/null \
    && git -C "$MIRROR" merge-base --is-ancestor "$installed" "$latestFull" 2> /dev/null; then
    count=$(git -C "$MIRROR" rev-list --count "$installed..$latestFull")
    if [ "$count" -gt 0 ]; then
        echo ":: What's new ($count):"
        git -C "$MIRROR" log --format='   %s' "$installed..$latestFull"
    fi
elif [ -n "$installed" ]; then
    echo ":: Installed version: $(pacman -Q vela-git | cut -d' ' -f2); new: $latest"
else
    echo ":: Vela isn't installed as a package: installing it ($latest)."
fi

# The repository on GitHub ("owner/name"): from the source, or from its origin
# if it's a directory. Empty if it isn't on GitHub.
githubRepo() {
    url="$source"
    if [ -d "$source" ]; then
        url=$(git -C "$source" remote get-url origin 2> /dev/null || true)
    fi
    url=$(githubHTTPS "$url")
    printf '%s\n' "$url" | sed -n -E 's#^(ssh://git@github\.com/|git@github\.com:|https://github\.com/)([^/]+/[^/]+)$#\2#p' | sed 's/\.git$//'
}

# This commit's package built by GitHub Actions, if it's still there (artifacts
# last 14 days): the run id, or empty.
ciRun=""
repo=$(githubRepo)
if [ "$prefer" != build ] && [ -n "$repo" ] && command -v gh > /dev/null && gh auth status > /dev/null 2>&1; then
    run=$(gh run list -R "$repo" -w build.yml -c "$latestFull" -s success -L 1 \
        --json databaseId -q '.[0].databaseId' 2> /dev/null || true)
    if [ -n "$run" ] && [ -n "$(gh api "repos/$repo/actions/runs/$run/artifacts" \
        -q '.artifacts[] | select(.name == "vela-git" and .expired == false) | .id' 2> /dev/null || true)" ]; then
        ciRun="$run"
    fi
fi

if [ "$check" = 1 ]; then
    if [ -n "$ciRun" ]; then
        echo ":: GitHub already has the package: vela-update downloads it instead of building."
    fi
    exit 0
fi

mkdir -p "$PACKAGES"
if [ -d "$CACHE/pacchetti" ]; then
    mv -f "$CACHE"/pacchetti/* "$PACKAGES"/ 2> /dev/null || true
    rm -rf "$CACHE/pacchetti" "$CACHE/scaricato" "$CACHE/costruzione" "$CACHE/sorgenti"
fi

# Only the last packages, to be able to go back.
prune() {
    ls -t "$PACKAGES"/vela-git-*.pkg.tar.* 2> /dev/null | tail -n +$((KEEP + 1)) | while read -r old; do
        rm -f "$old"
    done
}

# Package ready on GitHub: download it or build? Without a terminal (or with
# --download) it's downloaded.
if [ -n "$ciRun" ]; then
    answer=d
    if [ "$prefer" != download ] && [ -t 0 ]; then
        printf ':: GitHub already has the package built for this version.\n'
        printf '   Download and install it [D], or build it here [b]? '
        read -r answer || answer=d
    fi
    case "$answer" in
    b | B | build) ciRun="" ;;
    esac
fi
if [ -n "$ciRun" ]; then
    DOWNLOAD="$CACHE/download"
    rm -rf "$DOWNLOAD"
    echo ":: Downloading the package from GitHub"
    if gh run download "$ciRun" -R "$repo" -n vela-git -D "$DOWNLOAD" \
        && package=$(ls "$DOWNLOAD"/vela-git-[0-9]*."g$latest"-*.pkg.tar.* 2> /dev/null | head -n 1) \
        && [ -n "$package" ]; then
        mv -f "$package" "$PACKAGES/"
        rm -rf "$DOWNLOAD"
        package="$PACKAGES/$(basename "$package")"
        if ! sudo pacman -U "$package"; then
            echo "vela-update: the package was downloaded but not installed. To install it:" >&2
            echo "   sudo pacman -U $package" >&2
            exit 1
        fi
        prune
        echo ":: Vela is up to date ($(pacman -Q vela-git | cut -d' ' -f2)). The new version"
        echo "   starts with your next session: sign out and back in."
        exit 0
    fi
    rm -rf "$DOWNLOAD"
    echo ":: The GitHub package can't be downloaded: building it here." >&2
fi

# The build, with the new version's PKGBUILD.
WORK="$CACHE/build"
rm -rf "$WORK"
mkdir -p "$WORK"
git -C "$MIRROR" show "$latestFull:packaging/arch/PKGBUILD" > "$WORK/PKGBUILD"
# Advertise the selected commit to makepkg's mirror clone even when it was
# fetched by SHA and no branch points to it anymore.
git -C "$MIRROR" update-ref refs/vela-update/selected "$latestFull"
cd "$WORK"
export VELA_GIT_URL="file://$MIRROR#commit=$latestFull"
if [ -n "$jobs" ]; then
    export MAKEFLAGS="-j$jobs"
fi
echo ":: Building the package (a few minutes)"
if ! BUILDDIR="$WORK" PKGDEST="$PACKAGES" SRCDEST="$CACHE/sources" \
    makepkg --syncdeps --install --clean --force; then
    echo >&2
    # Built, but pacman didn't install it (cancelled, wrong password).
    built=$(ls -t "$PACKAGES"/vela-git-*."g$latest"-*.pkg.tar.* 2> /dev/null | head -n 1)
    if [ -n "$built" ]; then
        echo "vela-update: the package is ready but wasn't installed. To install it:" >&2
        echo "   sudo pacman -U $built" >&2
        exit 1
    fi
    echo "vela-update: the update failed (see the messages above)." >&2
    echo "If the compiler crashed (\"internal compiler error\"), try again" >&2
    echo "with fewer parallel jobs: vela-update --jobs 2" >&2
    exit 1
fi
rm -rf "$WORK"

prune

echo ":: Vela is up to date ($(pacman -Q vela-git | cut -d' ' -f2)). The new version"
echo "   starts with your next session: sign out and back in."
